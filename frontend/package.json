{
	"name": "frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || || tw-patch || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"proto:generate": "protoc -I=../proto/proto -I=../proto/vendor --plugin=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=src/lib/generated --ts_proto_opt=esModuleInterop=true $(find ../proto/proto -name '*.proto')"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"tailwindcss-patch": "^10.0.2",
		"typescript": "^6.0.3",
		"unplugin-tailwindcss-mangle": "^6.0.1",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@bufbuild/protobuf": "^2.13.0",
		"protobufjs": "^8.7.1",
		"ts-proto": "^2.12.0"
	}
}
